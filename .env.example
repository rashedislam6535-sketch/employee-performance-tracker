# Copy this file to .env and fill in the values.

# PostgreSQL connection string — Supabase, Neon, Docker or local Postgres all work.
#   Supabase (use the "Transaction pooler" string, port 6543 — it is IPv4-compatible):
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#   Neon:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
#   Postgres inside Docker/Coolify (no SSL):
#   DATABASE_URL=postgresql://workpulse:PASSWORD@db:5432/workpulse?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Shown on the dashboard and reports. Can be changed later in Settings.
OWNER_NAME=Ahsan Habib
OWNER_DEPARTMENT=Customer Support

# "true" fills an EMPTY database with sample entries so you can explore the app.
# Leave it "false" for your real tracker.
SEED_DEMO_DATA=false
