# ==============================================================================
# WorkPulse Enterprise - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your actual credentials.
#
# IMPORTANT:
# - Never commit your actual .env file to public Git repositories.
# - If your database password contains special characters (such as ?, @, #, &, %),
#   they must be URL-encoded (e.g., '?' becomes '%3F', '@' becomes '%40').
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# For Supabase (Recommended: Transaction Pooler on port 6543):
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.udkvkxaiduugqgnesxjp:YOUR_SUPABASE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# SSL Mode:
# - "require" (Default for remote databases like Supabase, Neon, Railway)
# - "disable" (Use only for local docker / localhost postgres without SSL)
PGSSLMODE="require"

# ------------------------------------------------------------------------------
# 2. Administrator & Initial Organization Setup (Optional)
# ------------------------------------------------------------------------------
# Default administrator seed information if initializing a fresh database:
OWNER_NAME="Rashed Islam"
OWNER_DEPARTMENT="Operations & Leadership"
OWNER_EMAIL="me@workpulse.local"

# ------------------------------------------------------------------------------
# 3. Application Host Configuration (Optional for Production Deployment)
# ------------------------------------------------------------------------------
# The canonical public URL of your deployed application:
# NEXT_PUBLIC_APP_URL="https://your-workpulse-app.vercel.app"
