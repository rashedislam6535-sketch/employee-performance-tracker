# Copy this file to .env and fill in the values.

# PostgreSQL connection string — Supabase, Neon, Docker or local Postgres all work.
#   Supabase (use the "Transaction pooler" string, port 6543 — it is IPv4-compatible):
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#   Neon:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
#   Postgres inside Docker/Coolify (no SSL):
#   DATABASE_URL=postgresql://workpulse:PASSWORD@db:5432/workpulse?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: pre-fills your profile on the very first run. Everything can be changed later on the Profile page.
OWNER_NAME=
OWNER_DEPARTMENT=
